mixin resume(opts)
  doctype html
  html(lang=opts.lang)
    head
      title= pageTitle
      meta(charset='UTF-8')
      meta(name='viewport' content='width=device-width, initial-scale=1.0')
      meta(http-equiv='X-UA-Compatible' content='ie=edge')
      link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Noto+Serif+SC:wght@400;700&display=swap')
      link(rel='stylesheet' href=opts.cssFile)
      link(rel='icon' href=icon type="image/x-icon")
    body
      div(class='top-btns')
        if opts.altVersion
          a(class='alt-btn' href='https://' + opts.altVersion title=opts.altVersionTitle)= opts.altVersionTitle
        button(class='print-btn' onclick='window.print()' title=opts.printBtnTitle) PDF
      div(class='page')
        //- Header: Name + Title
        header(class='header')
          h1(class='name')= name
          if title
            h2(class='jobtitle')= title

        //- Contact info in a single horizontal line
        div(class='contact-bar')
          each val, index in contact
            span(class='contact-item')
              span(class='contact-label')= index
              span(class='contact-sep') : 
              span(class='contact-value')= val

        hr(class='thick-rule')

        //- Profile
        if profile
          section(class='section')
            h2(class='section-title')= opts.profileTitle
            each item in profile
              p(class='profile-text')!= item

        //- Education
        section(class='section')
          h2(class='section-title')= opts.educationTitle
          each val, index in education
            div(class='entry')
              span(class='entry-date')= index
              span(class='entry-detail')= val

        //- Work Experience
        section(class='section')
          h2(class='section-title')= opts.workTitle
          each item in work_experience
            div(class='entry')
              div(class='entry-header')
                span(class='entry-company')= item.company_name
                span(class='entry-date')= item.from + ' – ' + item.to
              div(class='entry-position')= item.job_position
              if item.content
                p(class='entry-content')!= item.content
              if item.list
                ul(class='entry-list')
                  each val, index in item.list
                    li
                      if val.link
                        a(class='entry-link' href=val.link target='_blank')= index
                      else
                        strong= index
                      span #{opts.listSep}!{val.content}

        //- Personal Work / Projects
        if personal_work
          section(class='section')
            h2(class='section-title')= opts.projectsTitle
            ul(class='entry-list')
              each val, index in personal_work
                li
                  if val.link
                    a(class='entry-link' href=val.link target='_blank')= index
                  else
                    strong= index
                  span!= opts.projectSep + val.content

        //- Skills
        if skill
          section(class='section')
            h2(class='section-title')= opts.skillTitle
            div(class='skill-list')
              each val, index in skill
                - var level = Math.round(parseInt(val) / 20)
                - var dots = '●'.repeat(level) + '○'.repeat(5 - level)
                div(class='skill-item')
                  span(class='skill-name')= index
                  span(class='skill-dots')= dots

        //- Others
        if others
          section(class='section')
            h2(class='section-title')= opts.othersTitle
            div(class='others-list')
              each val, index in others
                div(class='others-item')
                  span(class='others-label') &#8226; #{index}
                  a(class='entry-link' href='https://' + val target='_blank')= val



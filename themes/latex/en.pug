doctype html
html(lang='en')
  head
    title= pageTitle
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    meta(http-equiv='X-UA-Compatible' content='ie=edge')
    link(rel='stylesheet' href='https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Noto+Serif+SC:wght@400;700&display=swap')
    link(rel='stylesheet' href='css/en.css')
    link(rel='icon' href=icon type="image/x-icon")
  body
    div(class='page')
      //- Header: Name + Title
      header(class='header')
        h1(class='name')= name
        if title
          h2(class='jobtitle')= title

      //- Contact info in a single horizontal line
      div(class='contact-bar')
        each val, index in contact
          span(class='contact-item')
            span(class='contact-label')= index
            span(class='contact-sep') : 
            span(class='contact-value')= val

      hr(class='thick-rule')

      //- Education
      section(class='section')
        h2(class='section-title') Education
        each val, index in education
          div(class='entry')
            span(class='entry-date')= index
            span(class='entry-detail')= val

      //- Profile
      if profile
        section(class='section')
          h2(class='section-title') Profile
          each item in profile
            p(class='profile-text')= item

      //- Work Experience
      section(class='section')
        h2(class='section-title') Work Experience
        each item in work_exprience
          div(class='entry')
            div(class='entry-header')
              span(class='entry-company')= item.company_name
              span(class='entry-date')= item.from + ' – ' + item.to
            div(class='entry-position')= item.job_position
            if item.content
              p(class='entry-content')= item.content
            if item.list
              ul(class='entry-list')
                each val, index in item.list
                  li
                    if val.link
                      a(class='entry-link' href=val.link target='_blank')= index
                    else
                      strong= index
                    span : !{val.content}

      //- Personal Work / Projects
      if personal_work
        section(class='section')
          h2(class='section-title') Open Source
          ul(class='entry-list')
            each val, index in personal_work
              li
                if val.link
                  a(class='entry-link' href=val.link target='_blank')= index
                else
                  strong= index
                span= ': ' + val.content

      //- Skills
      if skill
        section(class='section')
          h2(class='section-title') Skills & Expertise
          div(class='skill-list')
            each val, index in skill
              span(class='skill-item')= index

      //- Others
      if others
        section(class='section')
          h2(class='section-title') Others
          div(class='others-list')
            each val, index in others
              span(class='others-item')
                span(class='contact-label')= index
                span(class='contact-sep') : 
                a(class='entry-link' href='http://' + val target='_blank')= val

      //- Chinese Version
      if chinese_version
        section(class='section')
          h2(class='section-title') 中文版本
          p
            a(class='entry-link' href='http://' + chinese_version)= chinese_version
